{
  "id": "./",
  "name": "Pixprite",
  "short_name": "Pixprite",
  "description": "Pixel art and animation editor in the browser",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#231f2b",
  "theme_color": "#231f2b",
  "categories": ["graphics", "design", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-pixprite": [".pixprite"] },
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    },
    {
      "action": "./",
      "accept": { "application/x-aseprite": [".aseprite", ".ase"] },
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    },
    {
      "action": "./",
      "accept": {
        "image/png": [".png"],
        "image/gif": [".gif"],
        "image/webp": [".webp"],
        "image/jpeg": [".jpg", ".jpeg"]
      },
      "launch_type": "single-client"
    },
    {
      "action": "./",
      "accept": { "application/x-palette": [".gpl", ".pal", ".hex", ".act"] },
      "launch_type": "single-client"
    }
  ]
}
