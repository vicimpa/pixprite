{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/src.tsbuildinfo",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "types": ["vite/client", "vite-plugin-glsl/ext"],
    "paths": {
      "~/*": ["./*"],
      "@pixprite/ui": ["../packages/ui/src/index.ts"],
      "@pixprite/ui/*": ["../packages/ui/src/*"],
      "@pixprite/api": ["../packages/api/src/index.ts"],
      "@pixprite/api/*": ["../packages/api/src/*"]
    }
  },
  "include": ["."],
  "exclude": ["**/*.test.ts", "**/*.test-helper.ts"]
}
