{
  "id": "game-rig",
  "name": "%name%",
  "version": "0.5.1",
  "apiVersion": 1,
  "author": "Pixprite contributors",
  "description": "%description%",
  "entry": "main.js",
  "permissions": [
    "sprite:read",
    "sprite:write",
    "tags:lock",
    "ui:panel"
  ],
  "contributes": {
    "commands": [
      {
        "id": "settings",
        "label": "%cmd.settings%",
        "menu": "animation"
      },
      {
        "id": "preview",
        "label": "%cmd.preview%",
        "menu": "animation",
        "key": "Ctrl+Shift+G"
      },
      {
        "id": "unlock",
        "label": "%cmd.unlock%",
        "menu": "animation"
      },
      {
        "id": "export",
        "label": "%cmd.export%",
        "menu": "file"
      }
    ],
    "menus": [
      {
        "location": "tag",
        "command": "settings"
      }
    ],
    "panels": [
      {
        "id": "settings",
        "label": "%panel.settings%",
        "dock": "right",
        "page": "settings.html",
        "hidden": true,
        "minWidth": 220,
        "minHeight": 200,
        "detachable": true
      },
      {
        "id": "preview",
        "label": "%panel.preview%",
        "dock": "float",
        "page": "preview.html",
        "hidden": true,
        "width": 640,
        "height": 420,
        "minWidth": 320,
        "minHeight": 240
      }
    ],
    "exporters": [
      {
        "id": "rig",
        "label": "%export.label%",
        "extensions": [
          "zip"
        ]
      }
    ],
    "locales": "locales/"
  }
}
