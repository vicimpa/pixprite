{
  "name": "pixprite",
  "version": "0.0.6",
  "description": "Pixel art and animation editor for the web and desktop",
  "license": "MIT",
  "author": "vicimpa",
  "homepage": "https://vicimpa.github.io/pixprite/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vicimpa/pixprite.git"
  },
  "keywords": [
    "pixel-art",
    "sprite-editor",
    "animation",
    "tilemap",
    "editor"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "test:formats": "bun test src/core/PixpriteRoundTrip.test.ts src/core/formats",
    "test:migrations": "bun test src/core/PixpriteMigration.test.ts",
    "test:aseprite": "PIXPRITE_ASEPRITE_COMPAT=1 bun test src/core/formats/AsepriteRoundTrip.test.ts",
    "typecheck": "tsc -b",
    "i18n:check": "bun scripts/i18n-check.ts",
    "ext:dev": "bun scripts/build-extensions.ts --dev",
    "ext:check": "bun scripts/build-extensions.ts",
    "bundle:check": "bun scripts/bundle-check.ts && bun scripts/bundle-graph.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "benchmark": "bun benchmarks/runner.ts",
    "bundle:graph": "bun scripts/bundle-graph.ts",
    "desktop:compile": "bun scripts/build-desktop.ts --debug --no-bundle",
    "desktop:dev": "bun run build && bun run desktop:compile && bun scripts/run-desktop.ts",
    "desktop:pack": "bun run build && bun scripts/build-desktop.ts --no-bundle",
    "desktop:build": "bun run build && bun scripts/build-desktop.ts",
    "mcp": "bun scripts/run-desktop.ts --mcp",
    "mcp:proxy": "bun scripts/mcp-stdio-proxy.ts",
    "mcp:proxy:build": "bun build scripts/mcp-stdio-proxy.ts --outdir dist/desktop --target node",
    "docs:screenshot": "bun scripts/docs-screenshot.ts",
    "desktop:prepare": "bun scripts/build-desktop.ts --prepare",
    "desktop:check": "bun scripts/check-tauri-versions.ts",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:migrate": "bun scripts/migrate-electron.ts",
    "test:webview": "PIXPRITE_E2E_BROWSER=webkit playwright test --grep @smoke"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@preact/signals-react": "^3.12.0",
    "@vicimpa/decorators": "^0.0.15",
    "@vicimpa/easy-drag": "^0.1.12",
    "@vicimpa/events": "^0.0.13",
    "@vicimpa/glm": "^0.1.10",
    "@vicimpa/observers": "^0.0.9",
    "@vicimpa/react-decorators": "^0.1.12",
    "@vicimpa/rsp": "^0.1.9",
    "@vicimpa/week-store": "^0.0.10",
    "fast-deep-equal": "^3.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0",
    "sucrase": "^3.35.1",
    "twgl.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "fake-indexeddb": "^6.2.7",
    "sass-embedded": "^1.107.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-glsl": "^1.6.2",
    "zod": "^4.6.7"
  },
  "pixprite": {
    "repo": "vicimpa/pixprite"
  }
}
